rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Check if user is admin ──────────────────────
    function isAdmin() {
      return request.auth != null
        && request.auth.token.admin == true;
    }

    // ── Programs ────────────────────────────────────────────
    match /programs/{programId} {
      // Anyone can read programs
      allow read: if true;
      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ── Impact Stats ────────────────────────────────────────
    match /impact_stats/{statId} {
      // Anyone can read stats
      allow read: if true;
      // Only admins can write
      allow create, update, delete: if isAdmin();
    }

    // ── Donations ───────────────────────────────────────────
    match /donations/{donationId} {
      // Anyone can create (for recording donations)
      allow create: if true;
      // Only admins can read, update, or delete
      allow read, update, delete: if isAdmin();
    }

    // ── Volunteer Inquiries ─────────────────────────────────
    match /volunteer_inquiries/{inquiryId} {
      // Anyone can submit
      allow create: if true;
      // Only admins can read, update, or delete
      allow read, update, delete: if isAdmin();
    }

    // ── Contact Inquiries ───────────────────────────────────
    match /contact_inquiries/{inquiryId} {
      // Anyone can submit
      allow create: if true;
      // Only admins can read, update, or delete
      allow read, update, delete: if isAdmin();
    }

    // ── Program Updates / News ──────────────────────────────
    match /program_updates/{updateId} {
      // Anyone can read published updates
      allow read: if resource.data.published == true;
      // Only admins can read unpublished
      allow read: if isAdmin();
      // Only admins can write
      allow create, update, delete: if isAdmin();
    }
  }
}
